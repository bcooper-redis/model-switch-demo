# Server-side settings only.
# Copy values from your dedicated Redis Cloud database and Agent Memory store.
# Quote secrets with single quotes to preserve special characters.
# Do not use frontend prefixes such as VITE_ for credentials.

# Redis Cloud database endpoint: hostname only, without a scheme or port.
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_TLS=true

# Agent Memory data-plane endpoint and store-scoped credentials.
AGENT_MEMORY_BASE_URL=
AGENT_MEMORY_STORE_ID=
AGENT_MEMORY_API_KEY=

# OpenAI: required for answers and embeddings. See docs/install-and-run.md.
# Tested answering model: gpt-5.4-mini (requires account access).
# Use text-embedding-3-small; the current index expects 1536 dimensions.
OPENAI_API_KEY=
OPENAI_MODEL=
EMBEDDING_MODEL=

# Anthropic: required for Milestone 2 (provider switching).
# Paste your Anthropic API key here, for example: 'your-anthropic-api-key'
# Use an exact Claude model ID available to your Anthropic account.
# This is the initial model selected for Anthropic in the UI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Required for keys that are not scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=

# Optional comma-separated additional model IDs for the UI allowlists.
# The configured default above is always included. Restart after changes.
OPENAI_MODELS=gpt-4.1-mini
ANTHROPIC_MODELS=claude-haiku-4-5-20251001

# Application-owned demo namespace; contains no personal name.
DEMO_NAMESPACE=model-switch-demo

# Optional: downloaded Ollama models. No API key required.
# Set LOCAL_MODEL= to disable until the runtime and model are installed.
# Only literal loopback addresses are accepted. Cloud models are rejected.
LOCAL_BASE_URL=http://127.0.0.1:11434
LOCAL_MODEL=qwen3:4b-instruct
# Additional downloaded model tags for the model selector (optional).
LOCAL_MODELS=

# Milestone 4: managed LangCache. Create attributes named task, prompt_version,
# provider, model, and settings DURING service creation; they cannot be added later.
# See docs/install-and-run.md for the validated cache demo.
# Copy the HTTPS API base URL from the service, without /v1/caches/...
LANGCACHE_BASE_URL=
LANGCACHE_CACHE_ID=
LANGCACHE_API_KEY=

# Planned: Context Retriever is not integrated yet. Leave these fields blank.
# These are service credentials, not Redis
# database credentials or Agent Memory keys. Leave blank until provisioned.
CONTEXT_RETRIEVER_ADMIN_URL=
CONTEXT_RETRIEVER_ADMIN_KEY=
CONTEXT_RETRIEVER_SURFACE_ID=
CONTEXT_RETRIEVER_MCP_URL=
CONTEXT_RETRIEVER_AGENT_KEY=
